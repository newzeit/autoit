[Unit]
Description=ITurno AI - recepcion y soporte tecnico
After=network.target

[Service]
Type=simple
User=iturno
Group=iturno
WorkingDirectory=/opt/iturno-ai
Environment=NODE_ENV=production
# Ajustar la ruta al binario real de Node 24 (command -v node).
ExecStart=/usr/bin/node --env-file=/opt/iturno-ai/.env /opt/iturno-ai/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iturno-ai/data /opt/iturno-ai/backups

[Install]
WantedBy=multi-user.target

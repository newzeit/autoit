{
  "name": "iturno-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recepción y soporte IT con IA, tickets y modo demo persistente",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "admin:setup": "node --env-file-if-exists=.env scripts/admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test:browser": "node scripts/browser-test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
